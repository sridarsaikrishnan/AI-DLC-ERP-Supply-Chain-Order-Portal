<mxfile host="app.diagrams.net" type="device">
  <diagram id="hld-container" name="HLD - Container view">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="ERP &amp; Supply Chain Order Portal — High-Level Design (C4 container view)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="26" as="geometry" />
        </mxCell>

        <!-- ===== Boundaries (background) ===== -->
        <mxCell id="b_product" value="Product boundary — ERP &amp; Supply Chain Order Portal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;fontColor=#3b5a86;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="160" y="70" width="610" height="480" as="geometry" />
        </mxCell>
        <mxCell id="b_server" value="Trusted server zone (not reachable directly by browsers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;strokeWidth=1;dashed=1;verticalAlign=top;fontColor=#7a5a95;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="445" y="100" width="310" height="435" as="geometry" />
        </mxCell>
        <mxCell id="b_aws" value="Cloud — AWS managed services and data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;fontColor=#a9741a;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="580" width="1120" height="170" as="geometry" />
        </mxCell>
        <mxCell id="b_ext" value="External systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;fontColor=#8a3b38;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="110" width="230" height="350" as="geometry" />
        </mxCell>

        <!-- ===== Legend ===== -->
        <mxCell id="legend" value="Legend&#10;──────  synchronous request/response&#10;– – –   asynchronous event / message&#10;·······   uses (dependency)&#10;──▷     data read / write&#10;red       external API call&#10;blue      authentication (JWT)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=#b0b0b0;fillColor=#ffffff;rounded=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="92" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- ===== Actors ===== -->
        <mxCell id="a_res" value="Reseller" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="175" width="34" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a_op" value="Operator /&#10;distributor admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="385" width="34" height="64" as="geometry" />
        </mxCell>

        <!-- ===== Clients (SPAs) ===== -->
        <mxCell id="spa_res" value="&lt;b&gt;Reseller portal (SPA)&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#555&quot;&gt;Browse quotes, place orders, track status, manage webhook endpoints&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="185" y="160" width="175" height="80" as="geometry" />
        </mxCell>
        <mxCell id="spa_op" value="&lt;b&gt;Operator admin (SPA)&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#555&quot;&gt;Manage connections, resellers, items, quotes, office cards; view all orders&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="185" y="370" width="175" height="80" as="geometry" />
        </mxCell>

        <!-- ===== API host ===== -->
        <mxCell id="api" value="&lt;b&gt;API host (FastAPI)&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#444&quot;&gt;GraphQL (reseller + operator), inbound ERP webhook endpoint, request auth. Reseller surface never exposes ERP identity (FR-19).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="470" y="130" width="255" height="120" as="geometry" />
        </mxCell>

        <!-- ===== Worker host ===== -->
        <mxCell id="worker" value="&lt;b&gt;Worker host&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#444&quot;&gt;Async consumers (order routing, ERP delivery, projections, outbound webhook dispatch), outbox relay, reconciliation scheduler.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="470" y="300" width="255" height="120" as="geometry" />
        </mxCell>

        <!-- ===== Domain modules (shared) ===== -->
        <mxCell id="domain" value="&lt;b&gt;Domain modules (shared library, used by API + Worker)&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#444&quot;&gt;ordering (event-sourced) · quoting · catalog · tenancy · connections · fulfillment · integration (ERP adapters) · webhooks&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="460" y="458" width="275" height="66" as="geometry" />
        </mxCell>

        <!-- ===== AWS managed services + data ===== -->
        <mxCell id="cognito" value="&lt;b&gt;AWS Cognito&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#555&quot;&gt;Identity provider (JWT). Header stub for local dev.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="185" y="620" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="&lt;b&gt;AWS Secrets Manager&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#555&quot;&gt;ERP login + webhook signing secrets (never stored in DB).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="410" y="620" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bus" value="&lt;b&gt;Message bus&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#555&quot;&gt;SNS FIFO topic → SQS FIFO queues (+ DLQ). floci locally / AWS in prod.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="650" y="615" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;PostgreSQL (Aurora)&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#555&quot;&gt;Event store + outbox + snapshots · order projections · reference/CRUD data. Owned by the domain via API + Worker.&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="980" y="598" width="260" height="118" as="geometry" />
        </mxCell>

        <!-- ===== External systems ===== -->
        <mxCell id="erp" value="&lt;b&gt;ERP — Odoo&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#555&quot;&gt;System of record for orders. Receives orders (JSON-RPC); pushes status via webhooks. Other ERPs: TBD.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1070" y="165" width="190" height="115" as="geometry" />
        </mxCell>
        <mxCell id="whep" value="&lt;b&gt;Reseller webhook endpoints&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#555&quot;&gt;Reseller-operated receivers for order status notifications (HMAC-signed).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1070" y="320" width="190" height="100" as="geometry" />
        </mxCell>

        <!-- ===== Edges ===== -->
        <mxCell id="e1" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a_res" target="spa_res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a_op" target="spa_op"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="GraphQL /reseller (HTTPS, sync)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="spa_res" target="api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="GraphQL /operator (HTTPS, sync)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="spa_op" target="api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="verify JWT (sync)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#2d6cdf;fontColor=#2d6cdf;fontSize=10;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="api" target="cognito"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="write Order events + outbox;&#10;read projections" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;strokeColor=#6b6b6b;fontSize=10;exitX=1;exitY=0.9;entryX=0;entryY=0.2;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="read aggregates;&#10;write projections" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;strokeColor=#6b6b6b;fontSize=10;exitX=1;exitY=0.6;entryX=0;entryY=0.6;" edge="1" parent="1" source="worker" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="resolve secret" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;strokeColor=#6b6b6b;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="api" target="secrets"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="resolve ERP + webhook secrets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;strokeColor=#6b6b6b;fontSize=10;exitX=0.25;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="worker" target="secrets"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="outbox relay publishes (async)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=8 6;strokeColor=#9673a6;fontColor=#6a4b86;fontSize=10;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="db" target="bus"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="consume events (async)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=8 6;strokeColor=#9673a6;fontColor=#6a4b86;fontSize=10;exitX=0.5;exitY=1;entryX=0.3;entryY=1;" edge="1" parent="1" source="worker" target="bus"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="submit order (JSON-RPC, sync)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontColor=#8a3b38;fontSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.8;" edge="1" parent="1" source="worker" target="erp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="status webhook (HTTPS POST, async)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=8 6;strokeColor=#b85450;fontColor=#8a3b38;fontSize=10;exitX=0;exitY=0.3;entryX=1;entryY=0.2;" edge="1" parent="1" source="erp" target="api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="deliver webhook (HTTPS, HMAC, async)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=8 6;strokeColor=#b85450;fontColor=#8a3b38;fontSize=10;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="worker" target="whep"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;dashPattern=1 4;strokeColor=#999999;fontSize=9;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="api" target="domain"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;dashPattern=1 4;strokeColor=#999999;fontSize=9;exitX=0.3;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="worker" target="domain"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
